diff --git a/src/models/cdm.cpp b/src/models/cdm.cpp
new file mode 100644
index 000000000..325e66610
--- /dev/null
+++ b/src/models/cdm.cpp
@@ -0,0 +1,131 @@
+#include "models.h"
+#include <stdexcept>
+#include <cmath>
+#include <cstdlib>
+
+void llama_model_cdm::load_arch_hparams(llama_model_loader & ml) {
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_EPS, hparams.f_norm_eps);
+    ml.get_key("cdm.cdm.slot_count", slots_count);
+    ml.get_key("cdm.cdm.expert_count", experts_count);
+    auto array = [&](const char *key, std::vector<float> & out) {
+        int id = gguf_find_key(ml.metadata, key);
+        if (id < 0 || gguf_get_kv_type(ml.metadata,id) != GGUF_TYPE_ARRAY || gguf_get_arr_type(ml.metadata,id) != GGUF_TYPE_FLOAT32 || gguf_get_arr_n(ml.metadata,id) != hparams.n_layer()) throw std::runtime_error(std::string("invalid CDM array: ")+key);
+        auto data = (const float *)gguf_get_arr_data(ml.metadata,id);
+        out.assign(data,data+hparams.n_layer());
+    };
+    array("cdm.cdm.curvature_per_layer",curvature);
+    array("cdm.cdm.temperature_per_layer",temperature);
+    array("cdm.cdm.telepathy_beta_per_layer",beta);
+    if (!slots_count || !experts_count || slots_count > 4096 || experts_count > 256) throw std::runtime_error("invalid CDM slot/expert count");
+    if (!hparams.n_head() || hparams.n_embd % hparams.n_head()) throw std::runtime_error("invalid CDM attention dimensions");
+    for (size_t i=0;i<curvature.size();++i) if (!std::isfinite(curvature[i]) || curvature[i]<=0 || !std::isfinite(temperature[i]) || temperature[i]<=0 || !std::isfinite(beta[i])) throw std::runtime_error("invalid CDM routing scalar");
+    type = LLM_TYPE_UNKNOWN;
+}
+void llama_model_cdm::load_arch_tensors(llama_model_loader &) {
+    LLAMA_LOAD_LOCALS;
+    tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD,"weight"),{n_embd,n_vocab},0);
+    pos_embd = create_tensor(tn(LLM_TENSOR_POS_EMBD,"weight"),{n_embd,n_ctx_train},0);
+    embed_norm = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD_NORM,"weight",0),{n_embd},TENSOR_NOT_REQUIRED);
+    embed_norm_b = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD_NORM,"bias",0),{n_embd},TENSOR_NOT_REQUIRED);
+    output_norm = create_tensor(tn(LLM_TENSOR_OUTPUT_NORM,"weight"),{n_embd},0);
+    output_norm_b = create_tensor(tn(LLM_TENSOR_OUTPUT_NORM,"bias"),{n_embd},0);
+    output = create_tensor(tn(LLM_TENSOR_OUTPUT,"weight"),{n_embd,n_vocab},TENSOR_NOT_REQUIRED);
+    if (!output) output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD,"weight"),{n_embd,n_vocab},TENSOR_DUPLICATED);
+    routing.resize(n_layer);
+    for(int i=0;i<n_layer;++i) {
+        auto & l=layers[i]; auto & r=routing[i];
+        l.attn_norm=create_tensor(tn(LLM_TENSOR_ATTN_NORM,"weight",i),{n_embd},0);
+        l.attn_norm_b=create_tensor(tn(LLM_TENSOR_ATTN_NORM,"bias",i),{n_embd},0);
+        l.wqkv=create_tensor(tn(LLM_TENSOR_ATTN_QKV,"weight",i),{n_embd,3*n_embd},0);
+        l.wqkv_b=create_tensor(tn(LLM_TENSOR_ATTN_QKV,"bias",i),{3*n_embd},0);
+        l.wo=create_tensor(tn(LLM_TENSOR_ATTN_OUT,"weight",i),{n_embd,n_embd},0);
+        l.wo_b=create_tensor(tn(LLM_TENSOR_ATTN_OUT,"bias",i),{n_embd},0);
+        l.ffn_norm=create_tensor(tn(LLM_TENSOR_FFN_NORM,"weight",i),{n_embd},0);
+        l.ffn_norm_b=create_tensor(tn(LLM_TENSOR_FFN_NORM,"bias",i),{n_embd},0);
+        r.slots=create_tensor(tn(LLM_TENSOR_CDM_SLOTS,"weight",i),{n_embd,slots_count},0);
+        r.tele=create_tensor(tn(LLM_TENSOR_CDM_TELE,"weight",i),{slots_count,slots_count},0);
+        r.mapping=create_tensor(tn(LLM_TENSOR_CDM_SLOT_EXPERT,"weight",i),{slots_count,experts_count},0);
+        for(int e=0;e<experts_count;++e) {
+            r.gate.push_back(create_tensor(tn(LLM_TENSOR_CDM_GATE,"weight",i,e),{n_embd,n_ff},0));
+            r.up.push_back(create_tensor(tn(LLM_TENSOR_CDM_UP,"weight",i,e),{n_embd,n_ff},0));
+            r.down.push_back(create_tensor(tn(LLM_TENSOR_CDM_DOWN,"weight",i,e),{n_ff,n_embd},0));
+        }
+    }
+}
+std::unique_ptr<llm_graph_context> llama_model_cdm::build_arch_graph(const llm_graph_params &params) const { return std::make_unique<graph>(*this,params); }
+llama_model_cdm::graph::graph(const llama_model_cdm &model,const llm_graph_params &params):llm_graph_context(params) {
+    auto * x=build_inp_embd(model.tok_embd);
+    x=ggml_add(ctx0,x,ggml_get_rows(ctx0,model.pos_embd,build_inp_pos()));
+    if(model.embed_norm) x=build_norm(x,model.embed_norm,model.embed_norm_b,LLM_NORM,-1);
+    auto * attn=build_attn_inp_kv();
+    auto * out_ids=build_inp_out_ids();
+    ggml_tensor *prev=nullptr;
+    auto norm=[&](ggml_tensor *a,float eps) { return ggml_sqrt(ctx0,ggml_clamp(ctx0,ggml_sum_rows(ctx0,ggml_sqr(ctx0,a)),eps*eps,INFINITY)); };
+    for(int il=0;il<n_layer;++il) {
+        auto &l=model.layers[il]; auto &r=model.routing[il];
+        auto *h=build_norm(x,l.attn_norm,l.attn_norm_b,LLM_NORM,il);
+        auto [q,k,v]=build_qkv(l,h,hparams.n_embd_head_k(),n_head,n_head_kv,il);
+        auto *a=build_attn(attn,l.wo,l.wo_b,l.wo_s,q,k,v,nullptr,nullptr,nullptr,1.0f/sqrtf(hparams.n_embd_head_k()),il);
+        x=ggml_add(ctx0,x,a);
+        h=build_norm(x,l.ffn_norm,l.ffn_norm_b,LLM_NORM,il);
+        float c=model.curvature[il],sc=sqrtf(c);
+        auto *xt=ggml_scale(ctx0,ggml_div(ctx0,h,norm(h,1e-12f)),0.3f);
+        auto *xn=norm(xt,1e-12f);
+        auto *z=ggml_scale(ctx0,xn,sc);
+        auto *hyp=ggml_mul(ctx0,xt,ggml_div(ctx0,ggml_tanh(ctx0,ggml_clamp(ctx0,z,0,8)),z));
+        auto *hypn=norm(hyp,1e-12f);
+        auto *clip=ggml_clamp(ctx0,ggml_scale(ctx0,ggml_div(ctx0,ggml_scale_bias(ctx0,hypn,0,(1-1e-5f)/sc),hypn),1),0,1);
+        hyp=ggml_mul(ctx0,hyp,clip);
+        auto *cx=ggml_clamp(ctx0,ggml_scale(ctx0,ggml_sum_rows(ctx0,ggml_sqr(ctx0,hyp)),c),0,1-1e-5f);
+        auto *denx=ggml_scale_bias(ctx0,cx,-1,1);
+        ggml_tensor *logits=nullptr;
+        if (getenv("CDM_UNROLLED_ROUTER") && std::string(getenv("CDM_UNROLLED_ROUTER")) == "1") {
+        for(int s=0;s<model.slots_count;++s) {
+            auto *slot=ggml_view_2d(ctx0,r.slots,n_embd,1,r.slots->nb[1],s*r.slots->nb[1]);
+            auto *diff=ggml_sub(ctx0,hyp,slot);
+            auto *cy=ggml_clamp(ctx0,ggml_scale(ctx0,ggml_sum_rows(ctx0,ggml_sqr(ctx0,slot)),c),0,1-1e-5f);
+            auto *deny=ggml_scale_bias(ctx0,cy,-1,1);
+            auto *den=ggml_clamp(ctx0,ggml_mul(ctx0,denx,deny),1e-5f,INFINITY);
+            auto *arg=ggml_scale_bias(ctx0,ggml_div(ctx0,ggml_scale(ctx0,ggml_sum_rows(ctx0,ggml_sqr(ctx0,diff)),2*c),den),1,1);
+            arg=ggml_clamp(ctx0,arg,1+1e-5f,INFINITY);
+            auto *acosh=ggml_log(ctx0,ggml_add(ctx0,arg,ggml_sqrt(ctx0,ggml_scale_bias(ctx0,ggml_sqr(ctx0,arg),1,-1))));
+            auto *sim=ggml_scale(ctx0,acosh,-2/sc*model.temperature[il]);
+            logits=logits?ggml_concat(ctx0,logits,sim,0):sim;
+        }
+        } else {
+        // Evaluate all slot distances in one broadcast. The literal squared
+        // difference preserves the training arithmetic without dot-product cancellation.
+        const int64_t nt = hyp->ne[1];
+        auto *hyp3 = ggml_reshape_3d(ctx0,hyp,n_embd,1,nt);
+        auto *hyp_slots = ggml_repeat_4d(ctx0,hyp3,n_embd,model.slots_count,nt,1);
+        auto *slot3 = ggml_reshape_3d(ctx0,r.slots,n_embd,model.slots_count,1);
+        auto *diff = ggml_sub(ctx0,hyp_slots,slot3);
+        auto *cy = ggml_clamp(ctx0,ggml_scale(ctx0,ggml_sum_rows(ctx0,ggml_sqr(ctx0,slot3)),c),0,1-1e-5f);
+        auto *deny = ggml_scale_bias(ctx0,cy,-1,1);
+        auto *denx3 = ggml_reshape_3d(ctx0,denx,1,1,nt);
+        auto *den_slots = ggml_repeat_4d(ctx0,denx3,1,model.slots_count,nt,1);
+        auto *den = ggml_clamp(ctx0,ggml_mul(ctx0,den_slots,deny),1e-5f,INFINITY);
+        auto *arg = ggml_scale_bias(ctx0,ggml_div(ctx0,ggml_scale(ctx0,ggml_sum_rows(ctx0,ggml_sqr(ctx0,diff)),2*c),den),1,1);
+        arg = ggml_clamp(ctx0,arg,1+1e-5f,INFINITY);
+        auto *acosh = ggml_log(ctx0,ggml_add(ctx0,arg,ggml_sqrt(ctx0,ggml_scale_bias(ctx0,ggml_sqr(ctx0,arg),1,-1))));
+        logits = ggml_reshape_2d(ctx0,ggml_scale(ctx0,acosh,-2/sc*model.temperature[il]),model.slots_count,nt);
+        }
+        if(prev && model.beta[il]!=0) logits=ggml_add(ctx0,logits,ggml_scale(ctx0,ggml_mul_mat(ctx0,r.tele,prev),model.beta[il]));
+        prev=ggml_soft_max(ctx0,logits);
+        auto *weights=ggml_mul_mat(ctx0,r.mapping,prev);
+        ggml_tensor *moe=nullptr;
+        for(int e=0;e<model.experts_count;++e) {
+            auto *f=ggml_mul(ctx0,ggml_silu(ctx0,ggml_mul_mat(ctx0,r.gate[e],h)),ggml_mul_mat(ctx0,r.up[e],h));
+            f=ggml_mul_mat(ctx0,r.down[e],f);
+            auto *w=ggml_view_2d(ctx0,weights,1,weights->ne[1],weights->nb[1],e*weights->nb[0]);
+            f=ggml_mul(ctx0,f,w); moe=moe?ggml_add(ctx0,moe,f):f;
+        }
+        x=ggml_add(ctx0,x,moe);
+        cb(x,"l_out",il);
+    }
+    if(out_ids) x=ggml_get_rows(ctx0,x,out_ids);
+    x=build_norm(x,model.output_norm,model.output_norm_b,LLM_NORM,-1);
+    res->t_embd=x;
+    res->t_logits=build_lora_mm(model.output,x,model.output_s);
+    ggml_build_forward_expand(gf,res->t_logits);
+}
